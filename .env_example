# Database Configuration (Mapped to ConfigMap/Secret)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=skydivingrest1
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# Security (Mapped to Secret)
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_EXPIRATION_MINUTES=60

# CORS & Features (Mapped to ConfigMap)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:8080
SWAGGER_ENABLED=true
